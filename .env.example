RESEND_API_KEY=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin & Database Configuration (J1)
# PostgreSQL connection string from Neon (e.g. postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL=
# Generated via `node scripts/hash-password.mjs`
ADMIN_PASSWORD_HASH=
# Random string at least 32 characters long
ADMIN_SESSION_SECRET=

# Job Search Engine (J2)
# Groq API key for LLM triage of ambiguous job postings
GROQ_API_KEY=
# Secret token for Vercel Cron endpoint (random string at least 32 chars)
CRON_SECRET=

# Inbound Job Sources (Bundle A)
# Apify token for LinkedIn job/post scraping
APIFY_API_TOKEN=
# Apify actor ID (defaults to automly~linkedin-jobs-scraper)
APIFY_LINKEDIN_ACTOR_ID=
# Gmail address for alert email ingestion
GMAIL_IMAP_USER=
# 16-character Google App Password from myaccount.google.com/apppasswords
GMAIL_IMAP_APP_PASSWORD=
# IMAP server host (defaults to imap.gmail.com)
GMAIL_IMAP_HOST=
# IMAP server port (defaults to 993)
GMAIL_IMAP_PORT=
# Telegram Bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Webhook secret sent in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Owner Telegram chat ID (find it by messaging /whoami to your bot)
TELEGRAM_CHAT_ID=

# Sending outreach email (Bundle B4). Uses GMAIL_IMAP_USER and GMAIL_IMAP_APP_PASSWORD above.
# Optional daily send limit, default 20, maximum 100
OUTREACH_DAILY_SEND_CAP=

# Find contact (Hunter.io). Server side only, never prefix with NEXT_PUBLIC_.
# Free plan has 50 credits a month. Domain search and finder cost 1 per email found, verify costs 0.5.
HUNTER_API_KEY=
